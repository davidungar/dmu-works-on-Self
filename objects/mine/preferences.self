  "default user preferences"

preferences  printStackOnError: true
preferences  filesToShow add: 'transporter.self'
preferences  filesToShow add: 'mirror.self'
preferences  filesToShow add: 'programmingTests.self'
preferences  filesToShow add: 'objectScanner.self'
preferences  filesToShow add: 'preferences.self'
preferences  filesToShow add: 'beamOut.self'
preferences  filesToShow add: 'beamIn.self'
preferences  filesToShow add: 'transporterFiles.self'
preferences  filesToShow add: 'fileOut.self'
preferences  filesToShow add: 'module.self'
preferences  filesToShow add: 'modules.self'

preferences   useAmpersandToBackground: true
preferences   allowArrowGrabbing: true
preferences   blurArrows:	   false
preferences   mergeAssignmentSlots: true
preferences   useFontStyles: true

preferences isearchIgnoreCase: false


preferences   xDisplay:  'self:0' "0.1 for mono"

history keep: 100








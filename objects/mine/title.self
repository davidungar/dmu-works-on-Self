
times delay: 4000

ui _AddSlots: ( | boxPosInc <-  0 @ 0. boxPos <- 300 @ 300 | )

ui boxPos: ui boxPos + (50 @ 0)

ui add: '      Applying\n Animation Techniques\n        in the\n Self User Interface'

times delay: 2500

ui boxPos: ui boxPos + (-54 @ 170)

ui add: 'David Ungar & Bay-Wei Chang'

times delay: 1500

ui boxPos: ui boxPos + (-8 @ 90)

ui add: 'Sun Microsystems Laboratories\n      Stanford University'
 '-- Module body'

 bootstrap addSlotsTo: bootstrap stub -> 'globals' -> 'modules' -> () From: ( | {
         'ModuleInfo: Module: xpoint InitialContents: FollowSlot'
        
         xpoint = bootstrap define: bootstrap stub -> 'globals' -> 'modules' -> 'xpoint' -> () ToBe: bootstrap addSlotsTo: (
             bootstrap remove: 'directory' From:
             bootstrap remove: 'fileInTimeString' From:
             bootstrap remove: 'myComment' From:
             bootstrap remove: 'postFileIn' From:
             bootstrap remove: 'revision' From:
             bootstrap remove: 'subpartNames' From:
             globals modules init copy ) From: bootstrap setObjectAnnotationOf: bootstrap stub -> 'globals' -> 'modules' -> 'xpoint' -> () From: ( |
             {} = 'ModuleInfo: Creator: globals modules xpoint.

CopyDowns:
globals modules init. copy 
SlotsToOmit: directory fileInTimeString myComment postFileIn revision subpartNames.

\x7fIsComplete: '.
            | ) .
        } | ) 

 bootstrap addSlotsTo: bootstrap stub -> 'globals' -> 'modules' -> 'xpoint' -> () From: ( | {
         'ModuleInfo: Module: xpoint InitialContents: FollowSlot\x7fVisibility: public'
        
         directory <- ''.
        } | ) 

 bootstrap addSlotsTo: bootstrap stub -> 'globals' -> 'modules' -> 'xpoint' -> () From: ( | {
         'ModuleInfo: Module: xpoint InitialContents: InitializeToExpression: (_CurrentTimeString)\x7fVisibility: public'
        
         fileInTimeString <- _CurrentTimeString.
        } | ) 

 bootstrap addSlotsTo: bootstrap stub -> 'globals' -> 'modules' -> 'xpoint' -> () From: ( | {
         'ModuleInfo: Module: xpoint InitialContents: FollowSlot'
        
         myComment <- ''.
        } | ) 

 bootstrap addSlotsTo: bootstrap stub -> 'globals' -> 'modules' -> 'xpoint' -> () From: ( | {
         'ModuleInfo: Module: xpoint InitialContents: FollowSlot'
        
         postFileIn = ( |
            | resend.postFileIn).
        } | ) 

 bootstrap addSlotsTo: bootstrap stub -> 'globals' -> 'modules' -> 'xpoint' -> () From: ( | {
         'ModuleInfo: Module: xpoint InitialContents: FollowSlot\x7fVisibility: public'
        
         revision <- '$Revision:$'.
        } | ) 

 bootstrap addSlotsTo: bootstrap stub -> 'globals' -> 'modules' -> 'xpoint' -> () From: ( | {
         'ModuleInfo: Module: xpoint InitialContents: FollowSlot\x7fVisibility: private'
        
         subpartNames <- ''.
        } | ) 

 bootstrap addSlotsTo: bootstrap stub -> 'globals' -> () From: ( | {
         'Category: secured\x7fCategory: graphics\x7fModuleInfo: Module: xpoint InitialContents: FollowSlot\x7fVisibility: public'
        
         point = ( |
             x <- (0)@(0).
            | x _Clone).
        } | ) 



 '-- Side effects'

 globals modules xpoint postFileIn
